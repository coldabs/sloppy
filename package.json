{
  "name": "sloppy",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "sloppy": "./bin/sloppy.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "tsc -b && vite build && node scripts/build-cli.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "lint": "oxlint",
    "start": "node server.mjs",
    "preview": "node server.mjs",
    "prepare": "node scripts/prepare.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "bench": "vitest run bench/bench.test.ts",
    "check:citations": "node scripts/check-citations.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@tabler/icons-react": "^3.51.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
